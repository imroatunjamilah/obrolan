# Salin file ini menjadi .env lalu sesuaikan jika perlu.
# Nilai default di bawah memakai SQLite lokal — tidak ada kredensial.

# Path database SQLite (relatif terhadap folder prisma/)
DATABASE_URL="file:./dev.db"

# Kunci HMAC untuk token sesi admin & token akses mahasiswa.
# WAJIB diganti untuk layanan nyata (contoh: openssl rand -hex 32).
SECRET_KEY="dev-secret-key-CHANGE-ME-please"

# Masa aktif sesi admin (menit)
TOKEN_EXPIRE_MINUTES="480"

# Akun admin awal (dibuat otomatis saat login pertama di database kosong) —
# WAJIB diganti untuk layanan nyata
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ---------------------------------------------------------------- LLM (deploy)
# Dipakai saat deploy di luar sandbox pengembangan (mis. Vercel). Endpoint
# kompatibel OpenAI. Contoh gratis Z.ai Open Platform (model glm-4.5-flash):
#   LLM_BASE_URL="https://api.z.ai/api/paas/v4"
#   LLM_API_KEY="xxxxxxxx.xxxxxxxx"   (dari z.ai > API Keys)
#   LLM_MODEL="glm-4.5-flash"
# Jika dikosongkan, aplikasi memakai .z-ai-config (sandbox pengembangan).
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="glm-4.5-flash"
