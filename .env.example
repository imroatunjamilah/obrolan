# Salin file ini menjadi .env lalu sesuaikan jika perlu.
# Nilai default di bawah memakai SQLite lokal — tidak ada kredensial.

# Path database SQLite (relatif terhadap folder prisma/)
DATABASE_URL="file:./dev.db"

# Kunci HMAC untuk token sesi admin & token akses mahasiswa.
# WAJIB diganti untuk layanan nyata (contoh: openssl rand -hex 32).
SECRET_KEY="dev-secret-key-CHANGE-ME-please"

# Masa aktif sesi admin (menit)
TOKEN_EXPIRE_MINUTES="480"

# Akun admin awal (dipakai bun scripts/seed-admin.mjs) — hanya untuk development
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
