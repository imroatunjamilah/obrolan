// Varian Postgres dari prisma/schema.prisma — dipakai HANYA saat build di
// Vercel (lihat scripts/vercel-build.mjs). Model harus identik dengan skema
// SQLite yang dipakai di pengembangan. Koneksi diarahkan lewat env
// DATABASE_URL (di-inject otomatis oleh Vercel Storage / Neon).
// Privasi: skor & kategori DASS-21 TIDAK PERNAH dikirim ke mahasiswa,
// hanya tampil di panel petugas/admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id              String          @id @default(cuid())
  nama            String
  nim             String
  kontak          String
  jenisLayanan    String
  preferensiHari  String
  preferensiWaktu String
  keluhan         String?
  consentStatus   String          @default("disetujui")
  chatToken       String          @unique
  createdAt       DateTime        @default(now())
  dass21          Dass21Response?
  followup        Followup?
  conversations   Conversation[]

  @@index([nim])
  @@index([createdAt])
}

model Dass21Response {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  jawaban        String // JSON array 21 nilai 0-3
  skorDepresi    Int
  skorKecemasan  Int
  skorStres      Int
  katDepresi     String
  katKecemasan   String
  katStres       String
  scoringVersion String
  submittedAt    DateTime     @default(now())

  @@index([submittedAt])
}

model Followup {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  // menunggu_ditinjau | sedang_diproses | dijadwalkan | selesai | perlu_ditinjau_segera
  status         String       @default("menunggu_ditinjau")
  catatanPetugas String?
  petugasNama    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Akun internal UPA BK (admin/petugas). Mahasiswa TIDAK memiliki akun.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // PBKDF2-SHA256, tidak pernah plain text
  role         String   @default("admin") // admin | petugas
  namaLengkap  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Conversation {
  id             String        @id @default(cuid())
  title          String        @default("Percakapan Baru")
  status         String        @default("normal") // "normal" | "crisis" | "handoff"
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       Message[]

  @@index([registrationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String // "mahasiswa" | "bot" | "sistem" (sistem = audit marker, hanya petugas)
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
