// Varian Postgres dari prisma/schema.prisma — dipakai HANYA saat build di
// Vercel (lihat scripts/vercel-build.mjs). Model harus identik dengan skema
// SQLite yang dipakai di pengembangan. Koneksi diarahkan lewat env
// DATABASE_URL (di-inject otomatis oleh Vercel Storage / Neon).
// Privasi: skor & kategori DASS-21 TIDAK PERNAH dikirim ke mahasiswa,
// hanya tampil di panel petugas/admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id              String          @id @default(cuid())
  nama            String
  nim             String
  kontak          String
  jenisLayanan    String
  preferensiHari  String
  preferensiWaktu String
  keluhan         String?
  consentStatus   String          @default("disetujui")
  chatToken       String          @unique
  createdAt       DateTime        @default(now())
  dass21          Dass21Response?
  followup        Followup?
  conversations   Conversation[]

  @@index([nim])
  @@index([createdAt])
}

model Dass21Response {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  jawaban        String // JSON array 21 nilai 0-3
  skorDepresi    Int
  skorKecemasan  Int
  skorStres      Int
  katDepresi     String
  katKecemasan   String
  katStres       String
  scoringVersion String
  submittedAt    DateTime     @default(now())

  @@index([submittedAt])
}

model Followup {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  // menunggu_ditinjau | sedang_diproses | dijadwalkan | selesai | perlu_ditinjau_segera
  status         String       @default("menunggu_ditinjau")
  catatanPetugas String?
  petugasNama    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Akun internal UPA BK (admin/petugas). Mahasiswa TIDAK memiliki akun.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // PBKDF2-SHA256, tidak pernah plain text
  role         String   @default("admin") // admin | petugas
  namaLengkap  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Conversation {
  id             String        @id @default(cuid())
  title          String        @default("Percakapan Baru")
  status         String        @default("normal") // "normal" | "crisis" | "handoff"
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       Message[]

  @@index([registrationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String // "mahasiswa" | "bot" | "sistem" (sistem = audit marker, hanya petugas)
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ============================================================
// Modul KP — Sistem Penjadwalan Konseling UPA BK.
// Alur: pengajuan keluhan → klasifikasi urgensi (TF-IDF +
// Naive Bayes/SVM/Logistic Regression) → penjadwalan Greedy
// berbasis prioritas (kuota konselor, tanpa bentrok, kasus
// DARURAT didahulukan ≤ 48 jam).
// Data demo bersifat DUMMY/sintetis, bukan data skrining asli.
// ============================================================

model Konselor {
  id           String                @id @default(cuid())
  nama         String
  spesialisasi String
  kuotaHarian  Int                   @default(3) // maksimum sesi per konselor per hari
  isActive     Boolean               @default(true)
  penugasan    PermintaanKonseling[]
}

model PermintaanKonseling {
  id             String    @id @default(cuid())
  nama           String
  nim            String
  prodi          String
  kontak         String
  keluhan        String // teks keluhan yang diklasifikasi
  prefHari       String    @default("[]") // JSON array nama hari (Senin..Jumat)
  prefSesi       String    @default("[]") // JSON array kode sesi (S1..S4)
  // --- hasil klasifikasi urgensi ---
  prioritas      String    @default("NORMAL") // DARURAT | SEDANG | NORMAL
  confidence     Float     @default(0) // probabilitas kelas terpilih (0-1)
  modelDigunakan String    @default("") // naive_bayes | svm | logistic_regression
  skorKelas      String    @default("{}") // JSON probabilitas per kelas
  kataKunci      String    @default("[]") // JSON array kata kunci TF-IDF penunjang
  status         String    @default("menunggu") // menunggu | terjadwal | selesai | ditolak
  // --- hasil penjadwalan Greedy ---
  jadwalTanggal  String? // ISO yyyy-mm-dd
  jadwalHari     String? // Senin..Jumat
  jadwalSesi     String? // S1..S4
  konselorId     String?
  konselor       Konselor? @relation(fields: [konselorId], references: [id], onDelete: SetNull)
  catatanPetugas String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([prioritas])
  @@index([jadwalTanggal, jadwalSesi])
}
